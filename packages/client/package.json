{
  "name": "@kivyfn/store",
  "version": "0.1.0",
  "description": "Reactive browser and Node client for the kivyfn-store protocol",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && prettier --check src tests scripts *.json *.ts",
    "format": "prettier --write src tests scripts *.json *.ts",
    "test": "vitest run",
    "test:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  },
  "peerDependencies": {
    "mobx": "^7.0.5",
    "mobx-react-lite": "^5.1.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "mobx-react-lite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "mobx": "^7.0.5",
    "mobx-react-lite": "^5.1.0",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  }
}
