{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
